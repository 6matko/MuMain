<rml>
<head>
    <title>Event Schedule</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="event_schedule.rcss"/>
</head>
<body data-model="event_schedule">
    <div class="schedule-panel">
        <h2>{{title}}</h2>
        <div class="schedule-rows" data-if="available">
            <div class="schedule-row" data-for="row : rows" data-class-open="row.open" data-class-running="row.running">
                <div>{{row.name}}</div>
                <div class="schedule-status">{{row.status}}</div>
            </div>
        </div>
    </div>
</body>
</rml>
