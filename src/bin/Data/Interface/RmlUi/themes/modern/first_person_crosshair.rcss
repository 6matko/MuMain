body { width: 100%; height: 100%; pointer-events: none; }
.aim { position: absolute; width: 0dp; height: 0dp; pointer-events: none; }
.aim-horizontal { position: absolute; left: -5dp; top: -1dp; width: 10dp; height: 2dp; background-color: #ffffff; pointer-events: none; }
.aim-vertical { position: absolute; left: -1dp; top: -5dp; width: 2dp; height: 10dp; background-color: #ffffff; pointer-events: none; }
