.schedule-panel {
    position: absolute;
    right: 20dp;
    top: 40dp;
    width: 190dp;
    max-height: 80%;
    padding: 14dp;
    background-color: #171c24;
    color: #eeeeee;
    border: 1dp #667080;
    font-size: 12dp;
    pointer-events: auto;
}
.schedule-panel h2 { font-size: 14dp; color: #ffdc78; margin-bottom: 14dp; }
.schedule-rows { max-height: 240dp; overflow-y: auto; }
.schedule-row { margin-bottom: 10dp; }
.schedule-status { text-align: right; color: #aad2ff; }
.schedule-row.open .schedule-status { color: #78ff8c; }
.schedule-row.running .schedule-status { color: #ffbe64; }
.schedule-panel .btn { margin-top: 12dp; width: 100%; height: 26dp; }
