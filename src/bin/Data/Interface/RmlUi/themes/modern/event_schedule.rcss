.schedule-panel {
    position: absolute;
    right: 12dp;
    top: 36dp;
    width: 190dp;
    padding: 8dp 10dp;
    background-color: rgba(15, 16, 13, 160);
    color: #eeeeee;
    font-family: "token(font-body)";
    font-size: 11dp;
    pointer-events: none;
}
.schedule-panel h2 { font-size: 12dp; color: #ffdc78; margin-bottom: 8dp; }
.schedule-rows { display: block; }
.schedule-row { display: block; margin-bottom: 6dp; }
.schedule-status { text-align: right; color: #aad2ff; }
.schedule-row.open .schedule-status { color: #78ff8c; }
.schedule-row.running .schedule-status { color: #ffbe64; }
